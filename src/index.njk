---
layout: layouts/base.njk
metaTitle: "Acurris Analytical | Rapid Food Safety Test Kits and Sample Preparation in India"
description: "Rapid test kits for mycotoxins, antibiotic residues and milk adulterants, plus QuEChERS, dSPE, SPE and filtration consumables. Technical reply within 48 hours."
pageType: home
---
{%- set kits = categories | whereGroup("kits") %}
{%- set prep = categories | whereGroup("prep") %}
{%- set q = categories | findBySlug("quechers") %}
{%- set articles = collections.articles.slice(0, 3) %}

<section class="home-hero science-surface">
  {% set scienceFieldVariant = "science-field--hero" %}
  {% include "partials/science-field.njk" %}
  <div class="wrap home-hero-grid">
    <div class="home-hero-copy">
      <p class="eyebrow">TRUSTED SOLUTIONS FOR A SAFER TOMORROW</p>
      <h1>Advanced Analytical Solutions for <span>Safer Food, Feed &amp; Dairy</span></h1>
      <p class="lead">We provide reliable, innovative and easy-to-use solutions for mycotoxin, allergen, GMO, pesticide and veterinary drug analysis.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/products/" data-cta="hero">Explore Products</a>
        <a class="btn btn--secondary" href="/request-quote/">Request a Quote</a>
      </div>

    </div>

    <div class="home-hero-feature">
      <div class="home-hero-collage" aria-label="Analytical testing and food safety products">
        <figure class="home-collage-photo home-collage-photo--scientist"><img src="/assets/img/hero/scientist.webp" width="774" height="756" alt="Scientist examining a sample through a laboratory microscope" fetchpriority="high"></figure>
        <figure class="home-collage-photo home-collage-photo--glass"><img src="/assets/img/hero/pipette-glassware.webp" width="392" height="323" alt="Pipette above laboratory glassware" loading="lazy"></figure>
        <figure class="home-collage-photo home-collage-photo--vials"><img src="/assets/img/hero/sample-vials.webp" width="441" height="323" alt="Blue-capped laboratory sample vials" loading="lazy"></figure>
        <figure class="home-collage-photo home-collage-photo--food"><img src="/assets/img/hero/food-testing.webp" width="424" height="354" alt="Food sample being tested in a laboratory" loading="lazy"></figure>
        <figure class="home-collage-photo home-collage-photo--dairy"><img src="/assets/img/hero/dairy-feed.webp" width="409" height="354" alt="Dairy products and grain samples for food safety testing" loading="lazy"></figure>
        <a class="home-collage-callout home-collage-callout--top" href="/solutions/food-testing-labs/">
          <span class="home-collage-callout-icon">{% icon "flask-conical" %}</span>
          <span><strong>Innovative Solutions</strong><small>For Food, Feed &amp; Dairy Safety</small></span>
        </a>
        <a class="home-collage-callout home-collage-callout--bottom" href="/products/quechers/">
          <span class="home-collage-callout-icon">{% icon "shield-check" %}</span>
          <span><strong>Reliable Results</strong><small>For a Safer Tomorrow</small></span>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="home-feature-strip" aria-label="Acurris service highlights">
  <div class="wrap home-feature-strip-grid">
    <div class="home-feature-item">{% icon "microscope" %}<span><strong>Mycotoxin Analysis</strong><small>Reliable &amp; Sensitive</small></span></div>
    <div class="home-feature-item">{% icon "shield-check" %}<span><strong>Allergen Detection</strong><small>Safe Food for All</small></span></div>
    <div class="home-feature-item">{% icon "dna" %}<span><strong>GMO Testing</strong><small>Accurate &amp; Efficient</small></span></div>
    <div class="home-feature-item">{% icon "sprout" %}<span><strong>Pesticide Residues</strong><small>Ensure Food Safety</small></span></div>
    <div class="home-feature-item">{% icon "syringe" %}<span><strong>Veterinary Drug Analysis</strong><small>Compliance &amp; Quality</small></span></div>
  </div>
</section>

<section class="section science-surface home-products-section" aria-labelledby="product-title">
  {% set scienceFieldVariant = "science-field--products" %}
  {% include "partials/science-field.njk" %}
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Our products</p>
        <h2 id="product-title">Analytical Products for Every Application</h2>
      </div>
      <a class="arrow-link" href="/products/">View all products {% icon "arrow-right" %}</a>
    </div>

    <div class="home-product-grid">
      {% for c in categories.slice(0, 7) %}
        <a class="home-product-card{% if loop.first %} home-product-card--feature{% endif %}" href="/products/{{ c.slug }}/">
          <span class="home-product-media">
            <img src="/assets/img/products/{{ c.img }}-m.webp" width="800" height="600" alt="{{ c.name }} analytical product category" loading="lazy">
          </span>
          <span class="home-product-body">
            <strong>{{ c.name }}</strong>
            <span>{{ c.nav }}</span>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--well home-featured-solution science-surface" aria-labelledby="solution-title">
  {% set scienceFieldVariant = "science-field--solutions" %}
  {% include "partials/science-field.njk" %}
  <div class="wrap home-solution-grid">
    <div class="home-solution-media">
      <img src="/assets/img/products/cat-quechers-l.webp" srcset="/assets/img/products/cat-quechers-m.webp 512w, /assets/img/products/cat-quechers-l.webp 720w" sizes="(min-width: 1024px) 48vw, 100vw" width="720" height="540" alt="QuEChERS extraction and sample preparation workflow" loading="lazy">
    </div>

    <div class="home-solution-copy">
      <p class="eyebrow">Featured solution</p>
      <h2 id="solution-title">Reliable analytical solutions for demanding applications.</h2>
      <p>From rapid intake screening to chromatography-ready sample prep, our products support routine testing across food safety, pharmaceutical and industrial labs.</p>
      <ul class="home-solution-list">
        <li>QuEChERS and dSPE workflows</li>
        <li>Instrument-ready sample prep</li>
        <li>Support for method-matched product selection</li>
      </ul>
      <a class="btn btn--primary" href="/solutions/food-testing-labs/">Explore Solutions</a>
    </div>
  </div>
</section>

