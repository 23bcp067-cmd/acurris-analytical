      </div>
      <div class="home-newsletter-actions">
        <a class="btn btn--secondary" href="/resources/">View resources</a>
        <a class="btn btn--primary" href="mailto:{{ site.email }}?subject=Stay%20Updated">Email our team</a>
      </div>
    </div>
  </div>
</section>
