<section class="section home-editorial-section science-surface">
  {% set scienceFieldVariant = "science-field--solutions" %}
  {% include "partials/science-field.njk" %}
  <div class="wrap home-editorial-wrap">
    <div class="home-editorial-copy">
      <p class="eyebrow">Precision for every application</p>
      <h2>Analytical products designed to keep testing workflows reliable and efficient.</h2>
      <p>From intake screening to confirmatory sample preparation, our range helps labs and processing teams keep quality, compliance and safety on track.</p>
      <a class="btn btn--primary" href="/products/">Explore Products</a>
    </div>
    <div class="home-editorial-media">
      <img src="/assets/img/products/cat-spe-l.webp" srcset="/assets/img/products/cat-spe-m.webp 600w, /assets/img/products/cat-spe-l.webp 1200w" sizes="(min-width: 1024px) 52vw, 100vw" width="1200" height="900" alt="Analytical sample preparation and cleanup products" loading="lazy">
    </div>
  </div>
</section>

<section class="section science-surface home-resources-section" aria-labelledby="resources-title">
  {% set scienceFieldVariant = "science-field--resources" %}
  {% include "partials/science-field.njk" %}
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Resources &amp; Insights</p>
        <h2 id="resources-title">Practical guidance for analytical teams</h2>
      </div>
      <a class="arrow-link" href="/resources/">View all resources {% icon "arrow-right" %}</a>
    </div>

    <div class="home-resource-grid">
      {% for a in articles %}
        {% set relatedCat = categories | findBySlug(a.data.relatedCategories[0]) %}
        <article class="home-resource-card">
          <a href="{{ a.url }}" class="home-resource-link">
            <span class="home-resource-media">
              <img src="/assets/img/products/{{ relatedCat.img }}-m.webp" width="720" height="540" alt="{{ relatedCat.name }} product category" loading="lazy">
            </span>
            <span class="home-resource-meta">{{ relatedCat.name }} &middot; {{ a.data.date | readableDate }}</span>
            <strong>{{ a.data.title }}</strong>
            <span>{{ a.data.description }}</span>
            <em>Read Article {% icon "arrow-right" %}</em>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section home-cta-block">
  <div class="wrap">
    <div class="home-final-cta">
      {% set scienceFieldVariant = "science-field--dark" %}
      {% include "partials/science-field.njk" %}
      <div>
        <p class="eyebrow">Need help?</p>
        <h2>Need Help Finding the Right Analytical Product?</h2>
        <p>Our team can help with product selection, technical requirements and quotation requests.</p>
      </div>
      <div class="btn-row home-cta-actions">
        <a class="btn btn--primary" href="mailto:{{ site.email }}">Talk to Our Team</a>
        <a class="btn btn--secondary" href="/request-quote/">Request a Quote</a>
      </div>
    </div>
  </div>
</section>

<section class="section science-surface home-newsletter-section" aria-labelledby="newsletter-title">
