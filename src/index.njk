      </article>
      <article class="home-industry-card">
        <img src="/assets/img/applications/feed-testing.jpg" width="139" height="60" alt="Grain and animal feed" loading="lazy">
        <a class="home-industry-body" href="/solutions/feed-and-poultry/"><h3>Feed Testing</h3>{% icon "arrow-right" %}<span class="visually-hidden">Explore feed testing</span></a>
      </article>
      <article class="home-industry-card">
        <img src="/assets/img/applications/meat-poultry.jpg" width="139" height="60" alt="Fresh meat and poultry" loading="lazy">
        <a class="home-industry-body" href="/solutions/feed-and-poultry/"><h3>Meat &amp; Poultry</h3>{% icon "arrow-right" %}<span class="visually-hidden">Explore meat and poultry testing</span></a>
      </article>
      <article class="home-industry-card">
        <img src="/assets/img/applications/nutraceuticals.jpg" width="139" height="60" alt="Nutraceutical oil capsules" loading="lazy">
        <a class="home-industry-body" href="/products/spe/"><h3>Nutraceuticals</h3>{% icon "arrow-right" %}<span class="visually-hidden">Explore nutraceutical testing products</span></a>
      </article>
      <article class="home-industry-card">
        <img src="/assets/img/applications/pharmaceuticals.jpg" width="139" height="60" alt="Pharmaceutical tablets and capsules" loading="lazy">
        <a class="home-industry-body" href="/products/filtration/"><h3>Pharmaceuticals</h3>{% icon "arrow-right" %}<span class="visually-hidden">Explore pharmaceutical testing products</span></a>
      </article>
    </div>
  </div>
</section>

<section class="section section--well science-surface home-value-section" aria-labelledby="why-title">
  {% set scienceFieldVariant = "science-field--quiet" %}
  {% include "partials/science-field.njk" %}
  <div class="wrap">
    <div class="sec-head">
