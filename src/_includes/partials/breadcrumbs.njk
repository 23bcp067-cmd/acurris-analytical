{%- if breadcrumbs %}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {%- for b in breadcrumbs %}
    <li>{% if b.url and not loop.last %}<a href="{{ b.url }}">{{ b.label }}</a>{% else %}<span aria-current="page">{{ b.label }}</span>{% endif %}</li>
    {%- endfor %}
  </ol>
</nav>
{%- endif %}
