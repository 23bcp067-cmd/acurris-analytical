{#- Form macros. All forms post to /api/lead and work without JavaScript.
    With JavaScript, site.js validates on blur, submits by fetch, reveals RFQ step 2 and fires GA4 events. -#}

{% macro categoryOptions(selected) %}
<option value="">Select a category</option>
<optgroup label="Rapid test kits">
{%- for c in categories | whereGroup("kits") %}<option value="{{ c.slug }}"{% if selected == c.slug %} selected{% endif %}>{{ c.name }}</option>{% endfor %}
</optgroup>
<optgroup label="Sample preparation">
{%- for c in categories | whereGroup("prep") %}<option value="{{ c.slug }}"{% if selected == c.slug %} selected{% endif %}>{{ c.name }}</option>{% endfor %}
</optgroup>
<option value="several"{% if selected == 'several' %} selected{% endif %}>Several categories</option>
<option value="not-sure"{% if selected == 'not-sure' %} selected{% endif %}>Not sure yet</option>
{% endmacro %}

{% macro hidden(type, id, redirect) %}
<input type="hidden" name="form_type" value="{{ type }}">
<input type="hidden" name="redirect" value="{{ redirect }}">
<input type="hidden" name="page" value="{{ page.url }}">
<input type="hidden" name="ts" value="" data-ts>
<div class="hp" aria-hidden="true"><label for="{{ id }}-website">Website</label><input id="{{ id }}-website" type="text" name="company_website" tabindex="-1" autocomplete="off"></div>
{% endmacro %}

{% macro consent(id) %}
<div class="field field--full">
  <label class="consent" for="{{ id }}-consent">
    <input id="{{ id }}-consent" type="checkbox" name="consent" value="yes" required data-label="Consent">
    <span>I agree that Acurris Analytical may use these details to reply to my enquiry, as described in the <a href="/privacy/" target="_blank">privacy notice</a>.</span>
  </label>
</div>
{% endmacro %}

{% macro contactFields(id, needMobile=true) %}
<div class="field">
  <label for="{{ id }}-name">Full name</label>
  <input id="{{ id }}-name" name="name" type="text" autocomplete="name" required data-label="Full name">
</div>
<div class="field">
  <label for="{{ id }}-org">Organization</label>
  <input id="{{ id }}-org" name="organization" type="text" autocomplete="organization" required data-label="Organization">
</div>
<div class="field">
  <label for="{{ id }}-mobile">Mobile number</label>
  <input id="{{ id }}-mobile" name="mobile" type="tel" inputmode="tel" autocomplete="tel" {% if needMobile %}required {% endif %}pattern="[0-9 +\-]{10,16}" data-label="Mobile number" aria-describedby="{{ id }}-mobile-hint">
  <span class="hint" id="{{ id }}-mobile-hint">10-digit mobile, with or without +91</span>
</div>
<div class="field">
  <label for="{{ id }}-email">Work email</label>
  <input id="{{ id }}-email" name="email" type="email" inputmode="email" autocomplete="email" required data-label="Work email">
</div>
{% endmacro %}

{% macro qualifyFields(id, required=false) %}
{%- set opt = '' if required else ' <span class="optional">(optional)</span>' %}
<div class="field">
  <label for="{{ id }}-orgtype">Organization type{{ opt | safe }}</label>
  <select id="{{ id }}-orgtype" name="org_type"{% if required %} required{% endif %} data-label="Organization type">
    <option value="">Select</option>
    <option>Food testing lab (NABL or private)</option>
    <option>Dairy processor or cooperative</option>
    <option>Feed mill or poultry integrator</option>
    <option>Food manufacturer</option>
    <option>Exporter</option>
    <option>Government or research lab</option>
    <option>Other</option>
  </select>
</div>
<div class="field">
  <label for="{{ id }}-volume">Estimated tests per month{{ opt | safe }}</label>
  <select id="{{ id }}-volume" name="volume"{% if required %} required{% endif %} data-label="Estimated tests per month">
    <option value="">Select</option>
    <option>Under 100</option>
    <option>100 to 500</option>
    <option>500 to 2,000</option>
    <option>Over 2,000</option>
    <option>Not sure</option>
  </select>
</div>
<div class="field">
  <label for="{{ id }}-analytes">Analytes or products{{ opt | safe }}</label>
  <input id="{{ id }}-analytes" name="analytes" type="text"{% if required %} required{% endif %} placeholder="e.g. aflatoxin B1, beta-lactams, QuEChERS EN 15662" data-label="Analytes or products">
</div>
<div class="field">
  <label for="{{ id }}-matrix">Sample matrix{{ opt | safe }}</label>
  <input id="{{ id }}-matrix" name="matrix" type="text"{% if required %} required{% endif %} placeholder="e.g. raw milk, maize, groundnut, spices" data-label="Sample matrix">
</div>
<div class="field">
  <label for="{{ id }}-location">City and state{{ opt | safe }}</label>
  <input id="{{ id }}-location" name="location" type="text" autocomplete="address-level2"{% if required %} required{% endif %} data-label="City and state">
</div>
<div class="field">
  <label for="{{ id }}-timeline">When do you need supply?{{ opt | safe }}</label>
  <select id="{{ id }}-timeline" name="timeline"{% if required %} required{% endif %} data-label="Timeline">
    <option value="">Select</option>
    <option>Within 2 weeks</option>
    <option>Within a month</option>
    <option>1 to 3 months</option>
    <option>Just researching</option>
  </select>
</div>
<div class="field">
  <label for="{{ id }}-gst">GST number <span class="optional">(optional)</span></label>
  <input id="{{ id }}-gst" name="gst" type="text" autocomplete="off" maxlength="15" style="text-transform:uppercase" pattern="[0-9A-Za-z]{15}" data-label="GST number" aria-describedby="{{ id }}-gst-hint">
  <span class="hint" id="{{ id }}-gst-hint">15 characters. Speeds up a formal quotation</span>
</div>
<div class="field field--full">
  <label for="{{ id }}-message">Anything else we should know? <span class="optional">(optional)</span></label>
  <textarea id="{{ id }}-message" name="message" rows="4" placeholder="Current method, equipment, the limit you test against, or a technical question"></textarea>
</div>
{% endmacro %}

{#- Two-step RFQ. Step 1 captures the lead. Step 2 qualifies it and is optional. -#}
{% macro rfq(id="rfq", category="", heading="Request a quote", intro="") %}
<div class="form-card" data-rfq>
  <form id="{{ id }}-1" class="js-lead-form rfq-form is-active" action="{{ build.leadApiUrl }}" method="post" data-form-type="rfq1" data-event="rfq_step1_submit" data-category="{{ category }}" data-rfq-step="1">
    <div class="form-header">
      <p class="form-steps">Step 01</p>
      <h2 class="h3">Your Requirements</h2>
    </div>
    <p class="form-intro">{{ intro or "Share the product, application or technical requirement and our team can help with pricing, lead time and product information." }}</p>
    <div class="error-summary" tabindex="-1" hidden data-error-summary><h3>Please fix the following</h3><ul></ul></div>
    {{ hidden("rfq1", id, "/thank-you/quote/") }}
    <input type="hidden" name="items" value="" data-quote-items>

    <div class="rfq-form-grid">
      <div class="field field--full">
        <label for="{{ id }}-category">Product / Category</label>
        <select id="{{ id }}-category" name="category" required data-label="Product category">{{ categoryOptions(category) }}</select>
      </div>

      <div class="field field--half">
        <label for="{{ id }}-quantity">Quantity</label>
        <input id="{{ id }}-quantity" name="quantity" type="text" inputmode="numeric" placeholder="e.g. 500 tests, 2 boxes" data-label="Quantity">
      </div>

      <div class="field field--half">
        <label for="{{ id }}-unit">Unit</label>
        <select id="{{ id }}-unit" name="unit" data-label="Unit">
          <option value="">Select</option>
          <option>Tests</option>
          <option>Boxes</option>
          <option>Packets</option>
          <option>Vials</option>
          <option>Sets</option>
          <option>Other</option>
        </select>
      </div>

      <div class="field field--full">
        <label for="{{ id }}-requirement">Application / Requirement</label>
        <input id="{{ id }}-requirement" name="requirement" type="text" placeholder="e.g. Aflatoxin testing for maize, QuEChERS moisture control" data-label="Application / requirement">
      </div>

      <div class="field field--full">
        <label for="{{ id }}-message">Tell us about your requirement</label>
        <textarea id="{{ id }}-message" name="message" rows="5" placeholder="Share application details, specifications, preferred product, quantity or any technical requirements..."></textarea>
      </div>

      {{ consent(id) }}
    </div>

    <div class="form-actions">
      <button class="btn btn--primary btn--block" type="button" data-rfq-continue>Continue →</button>
      <p class="small muted">No spam. One reply from our team, by email or phone.</p>
    </div>
    <div class="form-status" role="status" aria-live="polite" hidden data-status></div>
  </form>

  <form id="{{ id }}-2" class="js-lead-form rfq-form" action="{{ build.leadApiUrl }}" method="post" data-form-type="rfq2" data-event="rfq_step2_submit" data-category="{{ category }}" data-rfq-step="2" hidden>
    <div class="form-status form-status--info" role="status">Your requirements are ready. Submit your contact details to send the request.</div>
    <div class="form-header">
      <p class="form-steps">Step 02</p>
      <h2 class="h3">Your contact details</h2>
    </div>
    <p class="form-intro">Tell us where to send the quote and who to contact.</p>
    <div class="error-summary" tabindex="-1" hidden data-error-summary><h3>Please fix the following</h3><ul></ul></div>
    {{ hidden("rfq2", id + "b", "/thank-you/quote/") }}
    <input type="hidden" name="lead_id" value="" data-lead-id>

    <div class="rfq-summary" aria-live="polite">
      <div class="rfq-summary-grid">
        <div><span>Products</span><strong data-rfq-summary-products>No products selected</strong></div>
        <div><span>Requirement</span><strong data-rfq-summary-requirement>Not provided</strong></div>
        <div><span>Quantity</span><strong data-rfq-summary-quantity>Not provided</strong></div>
      </div>
    </div>

    <div class="form-grid form-grid--2">
      {{ contactFields(id + "b") }}
    </div>

    <div class="form-actions rfq-actions-final">
      <button class="btn btn--secondary" type="button" data-rfq-back>Back</button>
      <button class="btn btn--primary" type="submit">Submit Request →</button>
    </div>
    <div class="form-status" role="status" aria-live="polite" hidden data-status></div>
  </form>
</div>
{% endmacro %}

{#- Evaluation pack: full qualifying form, everything required. -#}
{% macro sample(id="sample", category="") %}
<div class="form-card">
  <form id="{{ id }}" class="js-lead-form" action="{{ build.leadApiUrl }}" method="post" data-form-type="sample" data-event="sample_request_submit" data-category="{{ category }}">
    <h2 class="h3">Request an evaluation pack</h2>
    <p class="form-intro">We confirm availability and price by email before anything ships. Limit of {{ site.evalPack.limitPerOrg }} packs per organization.</p>
    <div class="error-summary" tabindex="-1" hidden data-error-summary><h3>Please fix the following</h3><ul></ul></div>
    {{ hidden("sample", id, "/thank-you/sample/") }}
    <input type="hidden" name="items" value="" data-quote-items>
    <div class="form-grid form-grid--2">
      {{ contactFields(id) }}
      <div class="field field--full">
        <label for="{{ id }}-category">Pack category</label>
        <select id="{{ id }}-category" name="category" required data-label="Pack category">{{ categoryOptions(category) }}</select>
      </div>
      {{ qualifyFields(id, true) }}
      <div class="field field--full">
        <label for="{{ id }}-address">Delivery address</label>
        <textarea id="{{ id }}-address" name="delivery_address" rows="3" autocomplete="street-address" required data-label="Delivery address"></textarea>
      </div>
      {{ consent(id) }}
    </div>
    <div class="form-actions">
      <button class="btn btn--primary btn--block" type="submit">Request evaluation pack</button>
      <p class="small muted">The pack cost is credited against your first order.</p>
    </div>
    <div class="form-status" role="status" aria-live="polite" hidden data-status></div>
  </form>
</div>
{% endmacro %}

{#- Spec sheet request, used while a category has no PDF yet. -#}
{% macro spec(id="spec", category="", name="") %}
<form id="{{ id }}" class="js-lead-form" action="{{ build.leadApiUrl }}" method="post" data-form-type="spec" data-event="spec_request_submit" data-category="{{ category }}">
  <div class="error-summary" tabindex="-1" hidden data-error-summary><h3>Please fix the following</h3><ul></ul></div>
  {{ hidden("spec", id, "/thank-you/spec/") }}
  <input type="hidden" name="category" value="{{ category }}">
  <div class="form-grid form-grid--2">
    {{ contactFields(id, false) }}
    {{ consent(id) }}
  </div>
  <div class="form-actions">
    <button class="btn btn--primary" type="submit">Email me the {{ name }} spec sheet</button>
  </div>
  <div class="form-status" role="status" aria-live="polite" hidden data-status></div>
</form>
{% endmacro %}

{#- Trade show QR form. ?event= in the URL prefills "Where we met". -#}
{% macro expo(id="expo") %}
<form id="{{ id }}" class="js-lead-form form-card" action="{{ build.leadApiUrl }}" method="post" data-form-type="expo" data-event="expo_form_submit">
  <div class="error-summary" tabindex="-1" hidden data-error-summary><h3>Please fix the following</h3><ul></ul></div>
  {{ hidden("expo", id, "/thank-you/quote/") }}
  <div class="form-grid">
    {{ contactFields(id) }}
    <div class="field">
      <label for="{{ id }}-category">What are you interested in?</label>
      <select id="{{ id }}-category" name="category" required data-label="Interest">{{ categoryOptions("") }}</select>
    </div>
    <div class="field">
      <label for="{{ id }}-event">Where we met</label>
      <input id="{{ id }}-event" name="event" type="text" data-event-field data-label="Where we met">
    </div>
    {{ consent(id) }}
  </div>
  <div class="form-actions">
    <button class="btn btn--primary btn--block" type="submit">Send my details</button>
  </div>
  <div class="form-status" role="status" aria-live="polite" hidden data-status></div>
</form>
{% endmacro %}
