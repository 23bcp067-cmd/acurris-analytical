{%- import "partials/forms.njk" as forms with context %}
<section class="cta-band" aria-labelledby="cta-band-title">
  <div class="container cta-band-grid">
    <div>
      <span class="eyebrow">Get pricing</span>
      <h2 id="cta-band-title">{{ ctaHeading or "Tell us what you test. We'll quote within " + site.supportHours + " hours." }}</h2>
      <p class="lead">Send your analyte, matrix and volume. A technical team member replies with the right kit or formulation, pricing, lead time and a spec sheet.</p>
      <ul class="contact-list">
        <li>{% icon "clock" %}<span>Technical reply within {{ site.supportHours }} hours on working days</span></li>
        <li>{% icon "package" %}<span><a href="/evaluation-pack/">Evaluation pack</a> available, cost credited to your first order</span></li>
        <li>{% icon "mail" %}<a href="mailto:{{ site.email }}" data-track="email_click">{{ site.email }}</a></li>
        {%- if site.phone %}<li>{% icon "phone" %}<a href="tel:{{ site.phone }}" data-track="call_click">{{ site.phoneDisplay or site.phone }}</a></li>{% endif %}
      </ul>
    </div>
    {{ forms.rfq("band", stickyCategory or "") }}
  </div>
</section>
